# Copy to .env for local development. NEVER commit the real .env file.

NODE_ENV=development
PORT=3000

# MongoDB connection string (MongoDB Atlas or local). Required in production.
MONGODB_URI=mongodb://127.0.0.1:27017/savory-bites

# Long random string (32+ characters) used to sign login sessions. Required in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# One-time secret that unlocks /admin/setup.html (only works while no admin exists).
# Alternative: leave empty and run "npm run create-admin".
SETUP_TOKEN=

# Restaurant WhatsApp number, international format, digits only (default already set in server/config/index.js).
# Local 08164212898 -> 2348164212898
WHATSAPP_NUMBER=2348164212898

# Maximum upload size per image, in MB.
MAX_IMAGE_MB=3

# Optional: comma-separated extra origins allowed to call the API (same-origin needs nothing).
ALLOWED_ORIGINS=

# Set to false to skip inserting fictional sample menu/gallery entries on first start.
SEED_SAMPLE_DATA=true
